<ehcache>
	<diskStore path="java.io.tmpdir/regal-api.cache" />
	<defaultCache maxBytesLocalHeap="128M" eternal="false"
		timeToIdleSeconds="300" timeToLiveSeconds="900"
		diskExpiryThreadIntervalSeconds="120" memoryStoreEvictionPolicy="LFU">
	</defaultCache>
	<sizeOfPolicy maxDepth="1000" maxDepthExceededBehavior="abort" />
</ehcache>
